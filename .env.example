# Server-side only. Never expose these to the client, and never commit
# real values — copy this file to .env.local and fill it in there
# (.env* is gitignored).

# Meta Model API key. When set, Muse Spark runs the interpret and
# explain steps live (see lib/agent.ts); when absent, the app runs its
# local pipeline and labels it honestly as local.
META_MODEL_API_KEY=

# Optional: Meta Model API chat-completions endpoint override.
# Defaults to Meta's chat-completions endpoint when unset.
META_MODEL_API_ENDPOINT=

# Optional: Meta model id override. Defaults to the current Muse Spark
# model id when unset.
META_MODEL_NAME=
